---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Top from "../../components/Pages/Blog/Top.astro";
import SearchAndCategory from "../../components/Pages/Blog/SearchAndCategory.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Get unique list of categories from posts
const categories = [...new Set(posts.map(post => post.data.category).filter(Boolean))] as string[];
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <BaseHead title={`Blog & Wawasan Teknologi - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body
    class="bg-slate-950 font-sans text-slate-200 antialiased selection:bg-blue-600/30 selection:text-blue-300"
  >
    <Header />

    <main class="relative w-full overflow-hidden pt-32 pb-24">
      <!-- Glow Accents -->
      <div
        class="pointer-events-none absolute top-10 left-1/4 h-[400px] w-[400px] rounded-full bg-blue-600/5 blur-[120px]"
      >
      </div>
      <div
        class="pointer-events-none absolute bottom-10 right-1/4 h-[400px] w-[400px] rounded-full bg-indigo-600/5 blur-[120px]"
      >
      </div>

      <!-- Cyberpunk subtle background pattern -->
      <div
        class="pointer-events-none absolute inset-0 -z-20 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] mask-[radial-gradient(ellipse_60%_50%_at_50%_40%,#000_60%,transparent_100%)] bg-size-[6rem_6rem] opacity-5"
      >
      </div>

      <div
        class="relative mx-auto max-w-[1500px] space-y-16 px-4 sm:px-6 lg:px-8"
      >
        <!-- Top Header Section -->
        <Top />

        <!-- Search and Category Filter -->
        <SearchAndCategory categories={categories} />

        <!-- Posts Grid -->
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            posts.map((post, index) => {
              const isFirst = index === 0;
              return (
                <article
                  data-post-card
                  data-title={post.data.title}
                  data-description={post.data.description}
                  data-category={post.data.category || ""}
                  class={`group relative overflow-hidden rounded-3xl border border-slate-200/80 bg-white/50 p-4 shadow-xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:border-blue-500/20 hover:shadow-blue-500/5 dark:border-white/6 dark:bg-slate-900/40 ${
                    isFirst ? "sm:col-span-2 lg:col-span-3 lg:grid lg:grid-cols-12 lg:gap-8 lg:p-6" : ""
                  }`}
                >
                  <!-- Glass Overlay Gradient -->
                  <div
                    class="pointer-events-none absolute inset-0 bg-linear-to-br from-blue-500/2 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                  />

                  <!-- Image Wrapper -->
                  <div
                    class={`relative overflow-hidden rounded-2xl border border-slate-200/50 dark:border-white/5 shadow-inner ${
                      isFirst ? "lg:col-span-7 h-[280px] sm:h-[360px] lg:h-[400px]" : "h-[220px]"
                    }`}
                  >
                    {post.data.heroImage && (
                      <Image
                        width={720}
                        height={360}
                        src={post.data.heroImage}
                        alt={post.data.title}
                        class="h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-103"
                      />
                    )}
                    <!-- Cyberpunk Grid Overlay -->
                    <div class="pointer-events-none absolute inset-0 border border-blue-500/10 rounded-2xl" />
                  </div>

                  <!-- Text Content -->
                  <div class={`flex flex-col justify-between py-4 ${isFirst ? "lg:col-span-5 lg:py-2" : ""}`}>
                    <div class="space-y-3">
                      <!-- Date / Metabar -->
                      <div class="flex items-center gap-3 text-xs font-semibold text-slate-500 dark:text-slate-500">
                        <div class="flex items-center gap-1">
                          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                          <FormattedDate date={post.data.pubDate} />
                        </div>
                        {post.data.category && (
                          <>
                            <span>•</span>
                            <span class="rounded-lg bg-blue-500/10 px-2 py-0.5 text-xs font-bold text-blue-600 dark:text-blue-400 border border-blue-500/10">
                              {post.data.category}
                            </span>
                          </>
                        )}
                      </div>

                      <!-- Title -->
                      <h2
                        class={`font-extrabold text-slate-950 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 ${
                          isFirst ? "text-2xl sm:text-3xl lg:text-4xl" : "text-xl sm:text-2xl"
                        }`}
                      >
                        <a href={`/blog/${post.id}/`} class="hover:underline">
                          {post.data.title}
                        </a>
                      </h2>

                      <!-- Description / Excerpt -->
                      {post.data.description && (
                        <p class={`leading-relaxed text-slate-600 dark:text-slate-400 font-medium ${isFirst ? "text-base sm:text-lg" : "text-sm line-clamp-3"}`}>
                          {post.data.description}
                        </p>
                      )}
                    </div>

                    <!-- Action Button -->
                    <div class="pt-6">
                      <a
                        href={`/blog/${post.id}/`}
                        class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-800 transition-all duration-300 hover:bg-slate-100 hover:text-slate-900 dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10"
                      >
                        Baca Selengkapnya
                        <svg
                          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
