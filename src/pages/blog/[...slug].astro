---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);

// Calculate word count & reading time dynamically on the server
const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BlogPost {...post.data} wordCount={wordCount} readingTime={readingTime} headings={headings}>
  <Content />
</BlogPost>
