---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import Top from "../../components/Pages/Projects/Top.astro";
import SearchAndFilter from "../../components/Pages/Projects/SearchAndFilter.astro";

const allProjects = await getCollection("projects", (project) => !project.data.draft);

// Sort by date (descending)
const projects = allProjects.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

// Get unique list of categories from projects
const categories = [...new Set(projects.map((project) => project.data.category).filter(Boolean))] as string[];
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <BaseHead
      title={`Karya & Portofolio Proyek Rekayasa - ${SITE_TITLE}`}
      description="Jelajahi berbagai proyek aplikasi website modern, sistem ERP kustom, aplikasi mobile native, dan solusi IT inovatif lainnya yang kami kembangkan di Tiba Tiba Ngoding."
    />
  </head>
  <body
    class="antialiased selection:bg-blue-600/30 selection:text-blue-300"
  >
    <Header />

    <main class="relative w-full overflow-hidden pt-32 pb-24">
      <!-- Glow Accents -->
      <div
        class="pointer-events-none absolute top-10 left-1/4 h-[400px] w-[400px] rounded-full bg-blue-600/5 blur-[120px]"
      >
      </div>
      <div
        class="pointer-events-none absolute bottom-10 right-1/4 h-[400px] w-[400px] rounded-full bg-indigo-600/5 blur-[120px]"
      >
      </div>

      <!-- Cyberpunk subtle background pattern -->
      <div
        class="pointer-events-none absolute inset-0 -z-20 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] mask-[radial-gradient(ellipse_60%_50%_at_50%_40%,#000_60%,transparent_100%)] bg-size-[6rem_6rem] opacity-5"
      >
      </div>

      <div
        class="relative mx-auto max-w-[1500px] space-y-16 px-4 sm:px-6 lg:px-8"
      >
        <!-- Top Header Section -->
        <Top />

        <!-- Search and Category Filter -->
        <SearchAndFilter categories={categories} />

        <!-- Projects Grid -->
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project) => {
              const { title, description, date, image, tags, category } = project.data;
              const formattedTags = tags ? tags.join(", ") : "";

              return (
                <article
                  data-project-card
                  data-title={title}
                  data-description={description}
                  data-tags={formattedTags}
                  data-category={category || ""}
                  class="group relative flex flex-col justify-between overflow-hidden rounded-[32px] border border-slate-200/80 bg-white/50 p-5 shadow-xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:border-blue-500/20 hover:shadow-blue-500/5 dark:border-white/6 dark:bg-slate-900/40"
                >
                  <!-- Glass Overlay Gradient -->
                  <div
                    class="pointer-events-none absolute inset-0 bg-linear-to-br from-blue-500/2 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                  />

                  <div>
                    <!-- Image Wrapper -->
                    {image && (
                      <div class="relative mb-6 h-[220px] overflow-hidden rounded-2xl border border-slate-200/50 shadow-inner dark:border-white/5">
                        <img
                          src={image}
                          alt={title}
                          class="h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-103"
                          loading="lazy"
                        />
                        {/* Tag Pills floating bottom left inside image */}
                        <div class="absolute bottom-4 left-4 flex flex-wrap gap-1.5">
                          {tags?.slice(0, 3).map((tag) => (
                            <span class="rounded-full border border-slate-200 bg-white/90 px-2.5 py-0.5 text-[9px] font-extrabold tracking-wider text-slate-600 uppercase shadow-sm backdrop-blur-md dark:border-white/10 dark:bg-[#0c0c0e]/90 dark:text-gray-400">
                              {tag}
                            </span>
                          ))}
                        </div>
                      </div>
                    )}

                    <!-- Text Content -->
                    <div class="space-y-3">
                      <!-- Metabar -->
                      <div class="flex items-center gap-3 text-xs font-semibold text-slate-500 dark:text-slate-500">
                        {date && (
                          <div class="flex items-center gap-1">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <FormattedDate date={date} />
                          </div>
                        )}
                        {category && (
                          <>
                            <span>•</span>
                            <span class="rounded-lg bg-blue-500/10 px-2 py-0.5 text-[10px] font-bold text-blue-600 dark:text-blue-400 border border-blue-500/10 uppercase">
                              {category}
                            </span>
                          </>
                        )}
                      </div>

                      <!-- Title -->
                      <h2 class="text-xl font-extrabold leading-tight text-slate-950 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                        <a href={`/projects/${project.id}/`} class="hover:underline">
                          {title}
                        </a>
                      </h2>

                      <!-- Description -->
                      {description && (
                        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400 font-medium line-clamp-3">
                          {description}
                        </p>
                      )}
                    </div>
                  </div>

                  <!-- Footer / CTA link -->
                  <div class="mt-6 pt-4 border-t border-slate-200/50 dark:border-white/5 flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-500 dark:text-slate-400 group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors duration-200">
                      Lihat Detail Kasus
                    </span>
                    <a
                      href={`/projects/${project.id}/`}
                      class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-slate-100 text-slate-700 shadow-md transition-all duration-300 group-hover:border-blue-600 group-hover:bg-blue-600 group-hover:text-white dark:border-white/10 dark:bg-white/5 dark:text-white cursor-pointer"
                      aria-label={`Lihat detail proyek ${title}`}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4.5 w-4.5 transition-transform duration-300 group-hover:translate-x-0.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M14 5l7 7m0 0l-7 7m7-7H3"
                        />
                      </svg>
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
