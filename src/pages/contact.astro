---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
import Top from "../components/Pages/Contact/Top.astro";
import Maps from "../components/Pages/Contact/Maps.astro";
import ContactItem from "../components/Pages/Contact/ContactItem.astro";
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <BaseHead
      title={`Hubungi & Berkolaborasi Dengan Kami - ${SITE_TITLE}`}
      description="Hubungi tim Tiba Tiba Ngoding untuk mendiskusikan rencana proyek digital, konsultasi arsitektur IT, pembuatan website kustom, dan aplikasi mobile."
    />
  </head>
  <body
    class="bg-slate-950 font-sans text-slate-200 antialiased selection:bg-blue-600/30 selection:text-blue-300"
  >
    <Header />

    <main class="relative w-full overflow-hidden pt-32 pb-24">
      <!-- Glow Accents -->
      <div
        class="pointer-events-none absolute top-10 left-1/4 h-[400px] w-[400px] rounded-full bg-blue-600/5 blur-[120px]"
      >
      </div>
      <div
        class="pointer-events-none absolute right-1/4 bottom-10 h-[400px] w-[400px] rounded-full bg-indigo-600/5 blur-[120px]"
      >
      </div>

      <!-- Cyberpunk subtle background pattern -->
      <div
        class="pointer-events-none absolute inset-0 -z-20 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] mask-[radial-gradient(ellipse_60%_50%_at_50%_40%,#000_60%,transparent_100%)] bg-size-[6rem_6rem] opacity-5"
      >
      </div>

      <div
        class="relative mx-auto max-w-[1500px] space-y-16 px-4 sm:px-6 lg:px-8"
      >
        <!-- Top Section -->
        <Top />

        <!-- Main Form & Info Grid -->
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
          <!-- Left Column: Interactive Map Widget (lg:col-span-7) -->
          <div class="lg:col-span-7">
            <Maps />
          </div>

          <!-- Right Column: Contact Info Cards (lg:col-span-5) -->
          <div
            class="space-y-6 lg:col-span-5 lg:flex lg:h-full lg:flex-col lg:justify-between lg:space-y-0"
          >
            <!-- WhatsApp Card -->
            <ContactItem
              title="Konsultasi Instan WhatsApp"
              borderColorHoverClass="hover:border-emerald-500/20 hover:shadow-emerald-500/5"
              overlayGradientFromClass="from-emerald-500/2"
              iconColorClass="text-emerald-500"
            >
              <svg
                slot="icon"
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.455 5.703 1.456h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
              <p
                class="text-sm leading-relaxed font-medium text-slate-600 dark:text-slate-400"
              >
                Ingin respon tercepat? Silakan hubungi kami langsung via
                WhatsApp untuk menjadwalkan panggilan konsultasi gratis.
              </p>
              <div class="pt-2">
                <a
                  href="https://wa.me/6285155343604"
                  target="_blank"
                  class="inline-flex items-center gap-2 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-2 text-xs font-bold text-emerald-600 transition-all duration-300 hover:bg-emerald-500 hover:text-white dark:text-emerald-400"
                >
                  Kirim Pesan WhatsApp
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </a>
              </div>
            </ContactItem>

            <!-- Email Card -->
            <ContactItem
              title="Surel Rekayasa & Bisnis"
              borderColorHoverClass="hover:border-blue-500/20 hover:shadow-blue-500/5"
              overlayGradientFromClass="from-blue-500/2"
              iconColorClass="text-blue-500"
            >
              <svg
                slot="icon"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <p
                class="text-sm leading-relaxed font-medium text-slate-600 dark:text-slate-400"
              >
                Untuk penawaran kerja sama formal, RFP (Request for Proposal),
                atau pertanyaan media, hubungi kami di:
              </p>
              <div class="pt-2">
                <a
                  href="mailto:tibatibangoding@gmail.com"
                  class="inline-flex items-center gap-2 rounded-xl border border-blue-500/20 bg-blue-500/10 px-4 py-2 text-xs font-bold text-blue-600 transition-all duration-300 hover:bg-blue-500 hover:text-white dark:text-blue-400"
                >
                  tibatibangoding@gmail.com
                </a>
              </div>
            </ContactItem>

            <!-- Jam Kerja Card -->
            <ContactItem
              title="Jam Operasional & Lokasi"
              borderColorHoverClass="hover:border-indigo-500/20 hover:shadow-indigo-500/5"
              overlayGradientFromClass="from-indigo-500/2"
              iconColorClass="text-indigo-500"
            >
              <svg
                slot="icon"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div
                class="space-y-1 text-sm font-medium text-slate-600 dark:text-slate-400"
              >
                <p>Senin - Jumat: 08:00 - 17:00 WIB</p>
                <p>Sabtu & Minggu: Tutup (Hanya Layanan Darurat)</p>
                <p
                  class="pt-1 text-xs font-semibold text-slate-500 dark:text-slate-500"
                >
                  Malang, Jawa Timur, Indonesia
                </p>
              </div>
            </ContactItem>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
