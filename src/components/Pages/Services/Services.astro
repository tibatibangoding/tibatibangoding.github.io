---
// Services Section Component showing detailed services in a premium 2x2 grid
---

<section
  id="services"
  class="dark:bg-dark-800/50 relative border-y border-slate-100 bg-slate-100/50 py-24 transition-colors duration-300 dark:border-white/5"
>
  <div
    class="pointer-events-none absolute top-1/2 left-0 h-[400px] w-[400px] rounded-full bg-blue-600/5 blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute right-0 bottom-0 h-[400px] w-[400px] rounded-full bg-indigo-600/5 blur-[120px]"
  >
  </div>

  <div class="mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-8">
    <!-- Service Details Grid Layout -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10">
      <!-- Jasa Website -->
      <div
        id="website"
        class="glass-panel flex scroll-mt-28 flex-col justify-between rounded-3xl border border-black/5 p-8 transition-all duration-300 hover:border-blue-500/20 sm:p-10 dark:border-white/5 dark:hover:border-blue-500/30"
      >
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-2xl border border-blue-500/20 bg-blue-600/10 text-blue-500"
            >
              <svg
                class="h-7 w-7"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg
              >
            </div>
            <span
              class="rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1 text-xs font-semibold tracking-wider text-blue-500 uppercase"
              >Populer</span
            >
          </div>
          <div class="space-y-3">
            <h3
              class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white"
            >
              1. Pembuatan Website
            </h3>
            <p
              class="text-sm leading-relaxed text-slate-600 dark:text-gray-400"
            >
              Kami membangun website company profile dan landing page dengan
              optimalisasi tinggi (SEO & Kecepatan Load). Menggunakan framework
              termodern seperti Astro, React, dan Tailwind CSS untuk menjamin
              website Anda beroperasi kurang dari 0.5 detik.
            </p>
          </div>
          <div class="border-t border-slate-100 pt-6 dark:border-white/5">
            <div
              class="grid grid-cols-1 gap-3 text-xs text-slate-600 sm:grid-cols-2 dark:text-gray-300"
            >
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>SEO & Schema Markup Terintegrasi</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Aman dari DDoS & SSL Gratis</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Penuh Fitur Kustom Sesuai Permintaan</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Hosting Cloud Premium Berkecepatan Tinggi</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Jasa App -->
      <div
        id="app"
        class="glass-panel flex scroll-mt-28 flex-col justify-between rounded-3xl border border-black/5 p-8 transition-all duration-300 hover:border-indigo-500/20 sm:p-10 dark:border-white/5 dark:hover:border-indigo-500/30"
      >
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-2xl border border-indigo-500/20 bg-indigo-600/10 text-indigo-500"
            >
              <svg
                class="h-7 w-7"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path></svg
              >
            </div>
          </div>
          <div class="space-y-3">
            <h3
              class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white"
            >
              2. Pembuatan Aplikasi Mobile
            </h3>
            <p
              class="text-sm leading-relaxed text-slate-600 dark:text-gray-400"
            >
              Menyediakan layanan pembuatan aplikasi Android, iOS, dan Desktop
              lintas platform (Cross-platform) menggunakan React Native dan
              Flutter. Kami menghadirkan database stabil dan real-time cloud
              data sinkronisasi untuk menjamin kelancaran aktivitas bisnis
              harian Anda.
            </p>
          </div>
          <div class="border-t border-slate-100 pt-6 dark:border-white/5">
            <div
              class="grid grid-cols-1 gap-3 text-xs text-slate-600 sm:grid-cols-2 dark:text-gray-300"
            >
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Rilis di Google Play Store & Apple App Store</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Integrasi Payment Gateway Otomatis</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Push Notification Realtime & User Tracking</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Skema Database Skala Besar yang Cepat</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Jasa IT Solutions -->
      <div
        id="it-consulting"
        class="glass-panel flex scroll-mt-28 flex-col justify-between rounded-3xl border border-black/5 p-8 transition-all duration-300 hover:border-purple-500/20 sm:p-10 dark:border-white/5 dark:hover:border-purple-500/30"
      >
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-2xl border border-purple-500/20 bg-purple-600/10 text-purple-500"
            >
              <svg
                class="h-7 w-7"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.58 4 8 4s8-1.79 8-4M4 7c0-2.21 3.58-4 8-4s8 1.79 8 4m0 5c0 2.21-3.58 4-8 4s-8-1.79-8-4"
                ></path>
              </svg>
            </div>
          </div>
          <div class="space-y-3">
            <h3
              class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white"
            >
              3. Sistem Aplikasi Kustom & ERP
            </h3>
            <p
              class="text-sm leading-relaxed text-slate-600 dark:text-gray-400"
            >
              Optimalkan produktivitas operasional kantor Anda melalui sistem
              terintegrasi. Kami membuat custom dashboard ERP untuk manajemen
              data, CRM untuk pelayanan pelanggan, dan program Point of Sales
              (Kasir) kustom.
            </p>
          </div>
          <div class="border-t border-slate-100 pt-6 dark:border-white/5">
            <div
              class="grid grid-cols-1 gap-3 text-xs text-slate-600 sm:grid-cols-2 dark:text-gray-300"
            >
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Otomatisasi Laporan & Stok Barang</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Analisa Data Grafis Interaktif</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Hak Akses Bertingkat Multi-User</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Migrasi Data Legacy Secara Aman</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Jasa UI/UX -->
      <div
        id="uiux"
        class="glass-panel flex scroll-mt-28 flex-col justify-between rounded-3xl border border-black/5 p-8 transition-all duration-300 hover:border-rose-500/20 sm:p-10 dark:border-white/5 dark:hover:border-rose-500/30"
      >
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-2xl border border-rose-500/20 bg-rose-600/10 text-rose-500"
            >
              <svg
                class="h-7 w-7"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
                ></path></svg
              >
            </div>
          </div>
          <div class="space-y-3">
            <h3
              class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white"
            >
              4. Pembuatan Desain UI/UX
            </h3>
            <p
              class="text-sm leading-relaxed text-slate-600 dark:text-gray-400"
            >
              Sebelum membangun code, kami merancang visual aplikasi terbaik
              untuk kenyamanan pengguna Anda. Kami menyediakan prototype
              fungsional di Figma yang interaktif memudahkan Anda menguji alur
              pengguna.
            </p>
          </div>
          <div class="border-t border-slate-100 pt-6 dark:border-white/5">
            <div
              class="grid grid-cols-1 gap-3 text-xs text-slate-600 sm:grid-cols-2 dark:text-gray-300"
            >
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Desain Responsif Mobile & Desktop</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Prototype Figma yang Bisa Diklik</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Brand Guideline & Asset Design</span>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="h-4 w-4 shrink-0 text-emerald-500 dark:text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path></svg
                >
                <span>Riset Perilaku Pengguna Kompetitor</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
