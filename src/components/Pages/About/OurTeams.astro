---
import { getCollection, render } from "astro:content";

const teamMembersRaw = await getCollection("teams");
const teamMembers = teamMembersRaw.filter(
  (member) => member.id !== "index" && member.data.active !== false,
);

// Sort to place Founder & CEO (Naufal Akbar Nugroho) first
const sortedTeam = teamMembers.sort((a, b) => {
  if (a.id.includes("naufal-akbar")) return -1;
  if (b.id.includes("naufal-akbar")) return 1;
  return a.data.title.localeCompare(b.data.title);
});

// Render the MDX contents for each team member
const renderedTeam = await Promise.all(
  sortedTeam.map(async (member) => {
    const { Content } = await render(member);
    return {
      ...member,
      Content,
    };
  }),
);
---

