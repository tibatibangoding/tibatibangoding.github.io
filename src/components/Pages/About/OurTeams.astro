<!-- Modal Interactivity Vanilla JS Script -->
<script>
  function initModals() {
    const triggers = document.querySelectorAll("[data-team-trigger]");
    const modals = document.querySelectorAll("[data-team-modal]");
    const socialLinks = document.querySelectorAll(".team-social-link");

    // Prevent modal triggering when clicking social links
    socialLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.stopPropagation();
      });
    });

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const id = trigger.getAttribute("data-team-trigger");
        const modal = document.getElementById(`modal-${id}`);
        if (modal) {
          // Open Modal
          modal.classList.remove("opacity-0", "pointer-events-none");
          modal.classList.add("opacity-100", "pointer-events-auto");

          // Animate content scale
          const card = modal.querySelector(".glass-panel");
          if (card) {
            card.classList.remove("scale-95");
            card.classList.add("scale-100");
          }

          // Disable scroll on body
          document.body.style.overflow = "hidden";
        }
      });
    });

    modals.forEach((modal) => {
      const closeBtn = modal.querySelector("[data-modal-close]");
      const card = modal.querySelector(".glass-panel");

      function closeModal() {
        modal.classList.remove("opacity-100", "pointer-events-auto");
        modal.classList.add("opacity-0", "pointer-events-none");

        if (card) {
          card.classList.remove("scale-100");
          card.classList.add("scale-95");
        }

        // Enable scroll on body
        document.body.style.overflow = "";
      }

      // Close on button click
      closeBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        closeModal();
      });

      // Close on backdrop click
      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal.classList.contains("opacity-100")) {
          closeModal();
        }
      });
    });
  }

  // Run on page load
  document.addEventListener("DOMContentLoaded", initModals);

  // Run on Astro page transition navigation (if using ViewTransitions)
  document.addEventListener("astro:page-load", initModals);
</script>
