---

<div class="space-y-20">
  {
    techCategories.map((category) => (
      <section class="relative space-y-8">
        <div
          class={`absolute top-0 left-0 h-80 w-80 ${category.glow} -z-10 rounded-full blur-[120px]`}
        />

        <div class="space-y-2">
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
            {category.title}
          </h2>
          <p class="max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-400 sm:text-base">
            {category.description}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
          {category.items.map((tech) => (
            <div
              class={`group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white/50 p-6 shadow-xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 dark:border-white/6 dark:bg-slate-900/40 ${tech.color}`}
            >
              <div class="absolute inset-0 bg-linear-to-br from-slate-500/5 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 dark:from-white/2" />

              <div class="flex items-start gap-4">
                <div
                  class="rounded-xl border border-slate-200/80 bg-slate-50 p-3.5 shadow-inner transition-transform duration-350 group-hover:scale-105 dark:border-white/4 dark:bg-slate-950/80"
                  set:html={tech.icon}
                />

                <div class="flex-1 space-y-2">
                  <h3 class="text-lg font-extrabold tracking-wide text-slate-950 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                    {tech.name}
                  </h3>
                  <p class="text-xs leading-relaxed font-medium text-slate-600 sm:text-sm dark:text-slate-400">
                    {tech.desc}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</div>
