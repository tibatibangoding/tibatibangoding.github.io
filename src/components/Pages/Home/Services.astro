---

---

<section
  id="services"
  class="dark:bg-dark-800/50 relative border-y border-slate-100 bg-slate-100/50 py-24 transition-colors duration-300 dark:border-white/5"
>
  <div
    class="pointer-events-none absolute top-1/2 left-0 h-[400px] w-[400px] rounded-full bg-blue-600/5 blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute right-0 bottom-0 h-[400px] w-[400px] rounded-full bg-indigo-600/5 blur-[120px]"
  >
  </div>

  <div class="mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-8">
    <div class="mb-20 space-y-4 text-center">
      <h2
        class="text-3xl font-bold tracking-tight text-slate-900 transition-colors duration-300 sm:text-5xl dark:text-white"
      >
        Layanan Unggulan Kami
      </h2>
      <p
        class="mx-auto max-w-2xl text-lg text-slate-600 transition-colors duration-300 dark:text-gray-400"
      >
        Kami memadukan inovasi teknologi dan desain premium untuk menciptakan
        produk digital bernilai tinggi bagi bisnis Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- Service 1: Pembuatan Website -->
      <div
        class="glass-panel glass-panel-hover flex flex-col justify-between rounded-3xl p-8"
      >
        <div>
          <div
            class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-blue-500/20 bg-blue-600/10 text-blue-500"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h3
            class="mb-3 text-xl font-bold text-slate-900 transition-colors duration-300 dark:text-white"
          >
            Pembuatan Website
          </h3>
          <p
            class="text-sm leading-relaxed text-slate-600 transition-colors duration-300 dark:text-gray-400"
          >
            Website company profile, landing page interaktif, dan e-commerce
            modern dengan performa tinggi & SEO-friendly.
          </p>
        </div>
        <a
          href="/services#website"
          class="group mt-8 flex items-center gap-1 text-sm font-semibold text-blue-600 transition-colors duration-200 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Detail Layanan <span
            class="transition-transform group-hover:translate-x-1">&rarr;</span
          >
        </a>
      </div>

      <!-- Service 2: Desain UI/UX -->
      <div
        class="glass-panel glass-panel-hover flex flex-col justify-between rounded-3xl p-8"
      >
        <div>
          <div
            class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-rose-500/20 bg-rose-600/10 text-rose-500"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
              ></path>
            </svg>
          </div>
          <h3
            class="mb-3 text-xl font-bold text-slate-900 transition-colors duration-300 dark:text-white"
          >
            Desain UI/UX
          </h3>
          <p
            class="text-sm leading-relaxed text-slate-600 transition-colors duration-300 dark:text-gray-400"
          >
            Riset pengguna mendalam, wireframing interaktif, dan desain visual
            mockup modern yang memanjakan mata.
          </p>
        </div>
        <a
          href="/services#uiux"
          class="group mt-8 flex items-center gap-1 text-sm font-semibold text-blue-600 transition-colors duration-200 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Detail Layanan <span
            class="transition-transform group-hover:translate-x-1">&rarr;</span
          >
        </a>
      </div>

      <!-- Service 3: Aplikasi Mobile -->
      <div
        class="glass-panel glass-panel-hover flex flex-col justify-between rounded-3xl p-8"
      >
        <div>
          <div
            class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-indigo-500/20 bg-indigo-600/10 text-indigo-500"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3
            class="mb-3 text-xl font-bold text-slate-900 transition-colors duration-300 dark:text-white"
          >
            Aplikasi Mobile
          </h3>
          <p
            class="text-sm leading-relaxed text-slate-600 transition-colors duration-300 dark:text-gray-400"
          >
            Pengembangan aplikasi Android dan iOS native maupun cross-platform
            (Flutter/React Native) yang stabil.
          </p>
        </div>
        <a
          href="/services#app"
          class="group mt-8 flex items-center gap-1 text-sm font-semibold text-blue-600 transition-colors duration-200 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Detail Layanan <span
            class="transition-transform group-hover:translate-x-1">&rarr;</span
          >
        </a>
      </div>

      <!-- Service 4: Aplikasi Kustom & ERP -->
      <div
        class="glass-panel glass-panel-hover flex flex-col justify-between rounded-3xl p-8"
      >
        <div>
          <div
            class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-purple-500/20 bg-purple-600/10 text-purple-500"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.58 4 8 4s8-1.79 8-4M4 7c0-2.21 3.58-4 8-4s8 1.79 8 4m0 5c0 2.21-3.58 4-8 4s-8-1.79-8-4"
              ></path>
            </svg>
          </div>
          <h3
            class="mb-3 text-xl font-bold text-slate-900 transition-colors duration-300 dark:text-white"
          >
            Aplikasi Kustom & ERP
          </h3>
          <p
            class="text-sm leading-relaxed text-slate-600 transition-colors duration-300 dark:text-gray-400"
          >
            Sistem ERP, CRM, manajemen database, dan solusi software
            terintegrasi yang disesuaikan khusus untuk bisnis Anda.
          </p>
        </div>
        <a
          href="/services#it-consulting"
          class="group mt-8 flex items-center gap-1 text-sm font-semibold text-blue-600 transition-colors duration-200 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Detail Layanan <span
            class="transition-transform group-hover:translate-x-1">&rarr;</span
          >
        </a>
      </div>
    </div>
  </div>
</section>
