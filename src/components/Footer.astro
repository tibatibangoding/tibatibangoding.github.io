---
const today = new Date();

const phone = "+62 851-5534-3604";
const address = "Malang, Jawa Timur, Indonesia";
const email = "tibatibangoding@gmail.com";

const companies = [
  { name: "Beranda", url: "/" },
  { name: "Tentang", url: "/about" },
  { name: "Teknologi", url: "/technologies" },
  { name: "Kontak", url: "/contact" },
];

const services = [
  { name: "Pembuatan Web", url: "/services/website" },
  { name: "Pembuatan Desain UI/UX", url: "/services/design" },
  { name: "Pembuatan Aplikasi Mobile", url: "/services/mobile" },
  { name: "Pembuatan Aplikasi Kustom & ERP", url: "/services/custom" },
];

const links = [
  { name: "Proyek Kami", url: "/projects" },
  { name: "Magang", url: "/internship" },
  { name: "Blog", url: "/blog" },
  { name: "Karir", url: "/career" },
  { name: "Download Company Profile", url: "#" },
];
---

<footer
  id="contact"
  class="relative overflow-hidden border-t border-slate-100 bg-slate-50 pt-16 pb-8 text-slate-900 transition-colors duration-300 dark:border-white/5 dark:bg-[#05070a] dark:text-white"
>
  <!-- Background Gradient Accents -->
  <div
    class="pointer-events-none absolute inset-0 bg-linear-to-b from-blue-500/5 via-transparent to-transparent transition-colors duration-300 dark:from-blue-500/10"
  >
  </div>

  <!-- Huge Background Logo -->
  <div
    class="pointer-events-none absolute -right-20 -bottom-20 h-[600px] w-[600px] rotate-12 opacity-[0.03] transition-all dark:opacity-5"
  >
    <img
      src="/assets/img/logo-no-text-white.png"
      alt=""
      class="logo-white h-full w-full object-contain brightness-0 invert"
    />
    <img
      src="/assets/img/logo-no-text-black.png"
      alt=""
      class="logo-black h-full w-full object-contain brightness-0"
    />
  </div>

  <!-- Dynamic Glows -->
  <div
    class="pointer-events-none absolute top-[-10%] left-[-10%] h-[600px] w-[600px] rounded-full bg-blue-600/10 mix-blend-screen blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute right-[-10%] bottom-[-10%] h-[600px] w-[600px] rounded-full bg-cyan-600/10 mix-blend-screen blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-[40%] left-[30%] h-[400px] w-[400px] rounded-full bg-purple-600/10 mix-blend-screen blur-[100px]"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-8">
    <!-- Top Section: Branding (Left) & Contact (Right) -->
    <div
      class="mb-12 flex flex-col items-start justify-between gap-8 lg:flex-row"
    >
      <!-- Branding -->
      <div class="max-w-2xl">
        <div class="mb-6">
          <a href="/" class="group inline-flex items-center gap-3">
            <img
              src="/assets/img/logo-white.png"
              alt="TTN Logo White"
              class="logo-white h-16 w-auto object-contain transition-all duration-300 group-hover:scale-105"
            />
            <img
              src="/assets/img/logo-black.png"
              alt="TTN Logo Black"
              class="logo-black h-16 w-auto object-contain transition-all duration-300 group-hover:scale-105"
            />
          </a>
        </div>
        <h2
          class="bg-clip-text text-2xl leading-normal font-bold text-slate-900 transition-colors md:text-3xl dark:bg-linear-to-r dark:from-white dark:via-gray-100 dark:to-blue-200 dark:text-transparent"
        >
          Wujudkan Produk Digital Impian Anda Bersama Kami.
        </h2>
        <p
          class="mt-4 max-w-lg text-base text-slate-600 transition-colors dark:text-gray-400"
        >
          Partner rekayasa perangkat lunak yang berfokus mendesain, membangun,
          dan meluncurkan solusi teknologi modern berskala global.
        </p>
      </div>
    </div>

    <!-- Contact Info - Compact Group -->
    <div
      class="mb-12 flex shrink-0 flex-col items-start justify-start gap-8 md:flex-row lg:gap-12"
    >
      <!-- Address -->
      <div class="flex items-start gap-3 lg:max-w-lg">
        <div
          class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-200/60 text-blue-600 dark:bg-white/5 dark:text-blue-400"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-4 w-4"
            ><path
              d="M18.364 17.364L12 23.7279L5.63604 17.364C2.12132 13.8492 2.12132 8.15076 5.63604 4.63604C9.15076 1.12132 14.8492 1.12132 18.364 4.63604C21.8787 8.15076 21.8787 13.8492 18.364 17.364ZM12 13C13.1046 13 14 12.1046 14 11C14 9.89543 13.1046 9 12 9C10.8954 9 10 9.89543 10 11C10 12.1046 10.8954 13 12 13Z"
            ></path></svg
          >
        </div>
        <div>
          <p
            class="mb-1 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-gray-300"
          >
            Alamat
          </p>
          <p
            class="text-sm leading-relaxed font-light text-slate-700 transition-colors dark:text-gray-400"
          >
            {address}
          </p>
        </div>
      </div>

      <!-- Phone -->
      <div class="flex w-full items-start gap-3 md:w-auto">
        <div
          class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-200/60 text-blue-600 dark:bg-white/5 dark:text-blue-400"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-4 w-4"
            ><path
              d="M9.36556 10.6821C10.3018 12.4137 11.8462 13.8398 13.6762 14.6739L14.7877 13.2559C15.029 12.9482 15.4267 12.81 15.7946 12.9061L19.4627 13.8631C19.9272 13.9843 20.2114 14.4952 20.0573 14.9547L19.0354 18.0031C18.8226 18.638 18.2366 19.0306 17.5732 18.9686C10.5109 18.3079 4.8817 12.9152 4.04169 5.86475C3.96277 5.10915 4.4173 4.40689 5.12217 4.19231L8.27581 3.23235C8.74903 3.08833 9.2568 3.39162 9.36214 3.86497L10.2238 7.73602C10.3129 8.13654 10.1444 8.5539 9.80517 8.81884L8.35649 9.95015C8.61908 10.2173 8.95995 10.4578 9.36556 10.6821Z"
            ></path></svg
          >
        </div>
        <div>
          <p
            class="mb-1 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-gray-300"
          >
            Telepon
          </p>
          <a
            href={`tel:${phone}`}
            class="text-base font-semibold text-slate-800 transition-colors hover:text-blue-600 dark:text-white dark:hover:text-blue-400"
          >
            {phone}
          </a>
        </div>
      </div>

      <!-- Email -->
      <div class="flex w-full items-start gap-3 md:w-auto">
        <div
          class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-200/60 text-blue-600 dark:bg-white/5 dark:text-blue-400"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-4 w-4"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path></svg
          >
        </div>
        <div>
          <p
            class="mb-1 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-gray-300"
          >
            Email
          </p>
          <a
            href={`mailto:${email}`}
            class="text-base font-semibold text-slate-800 transition-colors hover:text-blue-600 dark:text-white dark:hover:text-blue-400"
          >
            {email}
          </a>
        </div>
      </div>
    </div>

    <hr class="mb-8 border-slate-200 transition-colors dark:border-white/5" />

    <!-- Links Grid - Compact -->
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-12 lg:gap-8">
      <!-- Perusahaan -->
      <div class="lg:col-span-3">
        <h4
          class="mb-4 flex items-center gap-2 text-base font-bold text-slate-900 transition-colors dark:text-white"
        >
          Perusahaan
        </h4>
        <ul class="space-y-2">
          {
            companies.map((item) => (
              <li>
                <a
                  href={item.url}
                  class="group inline-flex items-center gap-2 text-sm text-slate-600 transition-all duration-300 hover:translate-x-1 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white"
                >
                  <span class="dark:bg-dark-700 h-1 w-1 rounded-full bg-slate-300 transition-colors group-hover:bg-blue-600 dark:group-hover:bg-blue-400" />
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Layanan -->
      <div class="lg:col-span-4">
        <h4
          class="mb-4 flex items-center gap-2 text-base font-bold text-slate-900 transition-colors dark:text-white"
        >
          Layanan
        </h4>
        <ul class="space-y-2">
          {
            services.map((item) => (
              <li>
                <a
                  href={item.url}
                  class="group inline-flex items-center gap-2 text-sm text-slate-600 transition-all duration-300 hover:translate-x-1 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white"
                >
                  <span class="dark:bg-dark-700 h-1 w-1 rounded-full bg-slate-300 transition-colors group-hover:bg-blue-600 dark:group-hover:bg-blue-400" />
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Tautan -->
      <div class="lg:col-span-5">
        <h4
          class="mb-4 flex items-center gap-2 text-base font-bold text-slate-900 transition-colors dark:text-white"
        >
          Tautan Lainnya
        </h4>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          {
            links.map((item) => (
              <div class="min-w-[45%]">
                <a
                  href={item.url}
                  class="group inline-flex items-center gap-2 text-sm text-slate-600 transition-all duration-300 hover:translate-x-1 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white"
                >
                  <span class="dark:bg-dark-700 h-1 w-1 rounded-full bg-slate-300 transition-colors group-hover:bg-blue-600 dark:group-hover:bg-blue-400" />
                  {item.name}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-6 transition-colors md:flex-row dark:border-white/5"
    >
      <p
        class="text-center text-xs text-slate-500 transition-colors dark:text-gray-500"
      >
        &copy; {today.getFullYear()} Tiba Tiba Ngoding. All rights reserved.
      </p>

      <div class="flex items-center gap-6">
        <span
          class="text-xs text-slate-400 transition-colors dark:text-gray-500"
          >Made with &hearts; by Tiba Tiba Ngoding Team</span
        >
      </div>
    </div>
  </div>
</footer>

<style>
  /* Local logo switcher targeting exactly like Header.astro */
  .logo-white {
    display: none;
  }
  .logo-black {
    display: block;
  }
  :global(.dark) .logo-white {
    display: block;
  }
  :global(.dark) .logo-black {
    display: none;
  }
</style>
